---
// Fixture de la charla: una sección deliberadamente mal hecha.
// `validate_file` (herramienta MCP) y `npm run ds:validate -- tests/fixtures/bad-section.astro` deben señalar cada problema.
const offers = [{ name: "Plan Pro", price: 19 }];
---

<section class="bad-offer">
  <h2 class="bad-offer__title">Oferta del mes</h2>
  <p class="bad-offer__lead" style="color: #ff6600; margin-top: 13px">Aprovecha el descuento antes de que termine.</p>

  <article class="bad-offer__card">
    <h3>{offers[0].name}</h3>
    <svg width="20" height="20" viewBox="0 0 24 24" fill="#f7931a"><path d="M5 12h14" stroke="#fff" /></svg>
    <span class="bg-[#ff6600] p-[13px]">Más vendido</span>
  </article>

  <table class="bad-offer__table">
    <tr><td>Bitcoin</td><td>$ 1.96</td></tr>
  </table>

  <button class="bad-offer__cta">Comprar ya</button>
  <a class="btn" href="#plans">Ver planes</a>
</section>

<style>
  .bad-offer {
    background: #1a1a1a;
    padding: 13px 27px;
    margin-top: 35px;
    border-radius: 6px;
    border: 2px solid #f60;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);
    font-family: "Helvetica", sans-serif;
    font-size: 15px;
    line-height: 21px;
    font-weight: bold;
    letter-spacing: 1px;
  }

  .bad-offer__title {
    color: rgb(255, 102, 0);
    font-size: 2.2rem;
  }

  .bad-offer__cta {
    gap: 9px;
    background: var(--color-brand);
    color: var(--color-orange-500);
    border-radius: var(--radius-8);
  }
</style>
