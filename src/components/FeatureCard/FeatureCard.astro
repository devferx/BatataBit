---
import Icon, { type Props as IconProps } from "../Icon/Icon.astro";

export interface Props {
  /** Glyph shown above the title. One of the Icon names that represent a feature. */
  icon: Extract<IconProps["name"], "clock" | "eye" | "dollar-sign" | "check-circle">;
  /** Card title, rendered as an `<h3>` (place the card under an `<h2>` section title). */
  title: string;
  /** Supporting sentence(s) under the title. */
  body: string;
}

const { icon, title, body } = Astro.props;
---

<article class="feature-card">
  <span class="feature-card__icon"><Icon name={icon} /></span>
  <h3 class="feature-card__title">{title}</h3>
  <p class="feature-card__body">{body}</p>
</article>

<style>
  .feature-card {
    width: 90%;
    min-width: 288px;
    max-width: 400px;
    min-height: 150px;
    margin: var(--space-16) auto;
    padding: var(--space-16);
    background-color: var(--color-surface-dark-raised);
    border-radius: var(--radius-card-compact);
    box-shadow: var(--shadow-on-dark);
  }

  /* 768px = breakpoint.tablet. Dos tarjetas por fila; el contenedor da el margen y el espacio entre ellas. */
  @media (min-width: 768px) {
    .feature-card {
      flex: 1 1 calc(50% - var(--space-8));
      width: auto;
      min-width: 0;
      max-width: none;
      margin: 0;
    }
  }

  .feature-card__icon {
    display: inline-block;
    width: 20px;
    height: 20px;
    margin-bottom: var(--space-12);
    color: var(--color-primary);
  }

  .feature-card__title {
    margin-bottom: var(--space-16);
    font-size: var(--text-title-sm-size);
    font-weight: var(--text-title-sm-weight);
    line-height: var(--text-title-sm-line);
    color: var(--color-text-on-dark);
  }

  .feature-card__body {
    font-size: var(--text-body-sm-size);
    font-weight: var(--text-body-sm-weight);
    line-height: var(--text-body-sm-line);
    color: var(--color-text-muted-on-dark);
  }
</style>
