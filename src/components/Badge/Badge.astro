---
export interface Props {
  /**
   * Colour scheme. `primary` / `secondary` are solid fills with dark text (promotional badges);
   * `primary-soft` / `secondary-soft` are tinted fills with dark text (informational chips).
   */
  tone: "primary" | "secondary" | "primary-soft" | "secondary-soft";
  /**
   * Typography. `sm` = bold label (text.badge) for badges that label a card ("Recomendado");
   * `md` = regular text (text.caption) for chips such as the "Actualizado" date chip; a
   * `<strong>` inside it takes the bold badge style.
   * @default "md"
   */
  size?: "sm" | "md";
}

const { tone, size = "md" } = Astro.props;
---

<span class:list={["badge", `badge--${size}`, `badge--${tone}`]}><slot /></span>

<style>
  .badge {
    display: block;
    width: fit-content;
    padding: var(--space-8);
    border-radius: var(--radius-chip);
    text-align: center;
  }

  .badge--sm {
    font-family: var(--text-badge-family);
    font-size: var(--text-badge-size);
    font-weight: var(--text-badge-weight);
    line-height: var(--text-badge-line);
  }

  .badge--md {
    font-family: var(--text-caption-family);
    font-size: var(--text-caption-size);
    font-weight: var(--text-caption-weight);
    line-height: var(--text-caption-line);
  }

  .badge :global(strong) {
    font-family: var(--text-badge-family);
    font-weight: var(--text-badge-weight);
  }

  .badge--primary {
    background-color: var(--color-primary);
    color: var(--color-on-primary);
  }

  .badge--secondary {
    background-color: var(--color-secondary);
    color: var(--color-on-secondary);
  }

  .badge--primary-soft {
    background-color: var(--color-primary-soft);
    color: var(--color-text-on-soft);
  }

  .badge--secondary-soft {
    background-color: var(--color-secondary-soft);
    color: var(--color-text-on-soft);
  }
</style>
