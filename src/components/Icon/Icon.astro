---
export type IconName =
  | "clock"
  | "eye"
  | "dollar-sign"
  | "check-circle"
  | "arrow-right"
  | "arrow-down"
  | "trending-up"
  | "trending-down";

export interface Props {
  /** Which glyph to draw. */
  name: IconName;
  /**
   * Rendered size: `sm` = 15px, `md` = 20px. Ignored by `arrow-down`, which is always 13×8.
   * @default "md"
   */
  size?: "sm" | "md";
  /**
   * Accessible name. When given, the icon is exposed as `role="img"` with this
   * `aria-label`; when omitted the icon is decorative (`aria-hidden`).
   * Always set it when the icon carries meaning by itself (e.g. trend up/down).
   */
  label?: string;
}

const { name, size = "md", label } = Astro.props;

interface Glyph {
  viewBox: string;
  /** `stroke` icons are outlines (stroke="currentColor"); `fill` icons are solid shapes. */
  kind: "stroke" | "fill";
  strokeWidth?: number;
  paths: string[];
}

const glyphs: Record<IconName, Glyph> = {
  clock: {
    viewBox: "0 0 24 24",
    kind: "stroke",
    strokeWidth: 2,
    paths: [
      "M12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2C6.47712 2 1.99997 6.47715 1.99997 12C1.99997 17.5228 6.47712 22 12 22Z",
      "M12 6V12L16 14",
    ],
  },
  eye: {
    viewBox: "0 0 24 24",
    kind: "stroke",
    strokeWidth: 2,
    paths: [
      "M1 12C1 12 5 4 12 4C19 4 23 12 23 12C23 12 19 20 12 20C5 20 1 12 1 12Z",
      "M12 15C13.6569 15 15 13.6569 15 12C15 10.3431 13.6569 9 12 9C10.3431 9 9 10.3431 9 12C9 13.6569 10.3431 15 12 15Z",
    ],
  },
  "dollar-sign": {
    viewBox: "0 0 24 24",
    kind: "stroke",
    strokeWidth: 2,
    paths: [
      "M12 1V23",
      "M17 5H9.5C8.57174 5 7.6815 5.36875 7.02513 6.02513C6.36875 6.6815 6 7.57174 6 8.5C6 9.42826 6.36875 10.3185 7.02513 10.9749C7.6815 11.6313 8.57174 12 9.5 12H14.5C15.4283 12 16.3185 12.3687 16.9749 13.0251C17.6313 13.6815 18 14.5717 18 15.5C18 16.4283 17.6313 17.3185 16.9749 17.9749C16.3185 18.6313 15.4283 19 14.5 19H6",
    ],
  },
  "check-circle": {
    viewBox: "0 0 24 24",
    kind: "stroke",
    strokeWidth: 2,
    paths: [
      "M22 11.08V12C21.9988 14.1564 21.3005 16.2547 20.0093 17.9818C18.7182 19.709 16.9033 20.9725 14.8354 21.5839C12.7674 22.1953 10.5573 22.1219 8.53446 21.3746C6.51167 20.6273 4.78465 19.2461 3.61095 17.4371C2.43726 15.628 1.87978 13.4881 2.02167 11.3363C2.16355 9.18455 2.9972 7.13631 4.39827 5.49706C5.79935 3.85781 7.69278 2.71537 9.79618 2.24013C11.8996 1.7649 14.1003 1.98232 16.07 2.85999",
      "M22 4L12 14.01L9 11.01",
    ],
  },
  "arrow-right": {
    viewBox: "0 0 24 24",
    kind: "stroke",
    strokeWidth: 2,
    paths: ["M5 12H19", "M12 5L19 12L12 19"],
  },
  "arrow-down": {
    viewBox: "0 0 13 8",
    kind: "fill",
    paths: [
      "M1.91 0.589966L6.5 5.16997L11.09 0.589966L12.5 1.99997L6.5 7.99997L0.5 1.99997L1.91 0.589966Z",
    ],
  },
  "trending-up": {
    viewBox: "0 0 12 12",
    kind: "stroke",
    strokeWidth: 1,
    paths: ["M11.5 3L6.75 7.75L4.25 5.25L0.5 9", "M8.5 3H11.5V6"],
  },
  "trending-down": {
    viewBox: "0 0 12 13",
    kind: "stroke",
    strokeWidth: 1,
    paths: ["M11.5 9.5L6.75 4.75L4.25 7.25L0.5 3.5", "M8.5 9.5H11.5V6.5"],
  },
};

const glyph = glyphs[name];
const px = size === "sm" ? 15 : 20;
const [width, height] = name === "arrow-down" ? [13, 8] : [px, px];
const a11y = label ? { role: "img", "aria-label": label } : { "aria-hidden": "true" };
---

<svg
  class:list={["icon", `icon--${name}`]}
  width={width}
  height={height}
  viewBox={glyph.viewBox}
  preserveAspectRatio="xMidYMid slice"
  fill={glyph.kind === "fill" ? "currentColor" : "none"}
  stroke={glyph.kind === "stroke" ? "currentColor" : undefined}
  stroke-width={glyph.strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  focusable="false"
  {...a11y}
>
  {glyph.paths.map((d) => <path d={d} />)}
</svg>

<style>
  .icon {
    display: block;
    flex-shrink: 0;
  }

  .icon--trending-up {
    color: var(--color-trend-up);
  }

  .icon--trending-down {
    color: var(--color-trend-down);
  }
</style>
