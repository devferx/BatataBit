---
import Badge, { type Props as BadgeProps } from "../Badge/Badge.astro";
import Button from "../Button/Button.astro";

export interface Props {
  /** Plan name, rendered as an `<h3>` (place the card under an `<h2>` section title). */
  title: string;
  /** Price in dollars, shown large with a small "$" prefix. */
  price: number;
  /** Small supporting note under the price (what the plan includes or saves). */
  note: string;
  /**
   * Optional highlight pinned to the top edge of the card.
   * `tone` must be a solid tone (`primary` | `secondary`).
   * @default undefined (no badge)
   */
  badge?: {
    label: string;
    tone: Extract<BadgeProps["tone"], "primary" | "secondary">;
  };
  /** Visible label of the call-to-action button (e.g. "Escoger este"). */
  ctaLabel: string;
  /**
   * Accessible name of the call-to-action button. Must contain the visible `ctaLabel` text
   * (WCAG 2.5.3) and name the plan so identical buttons stay distinguishable
   * (e.g. "Escoger el plan Pago Mensual").
   */
  ctaAriaLabel: string;
}

const { title, price, note, badge, ctaLabel, ctaAriaLabel } = Astro.props;
---

<article class="plan-card">
  {
    badge && (
      <div class="plan-card__badge">
        <Badge tone={badge.tone} size="sm">
          {badge.label}
        </Badge>
      </div>
    )
  }
  <h3 class="plan-card__title">{title}</h3>
  <p class="plan-card__price"><span>$</span>{price}</p>
  <p class="plan-card__note">{note}</p>
  <div class="plan-card__action">
    <Button variant="outline" icon="arrow-right" ariaLabel={ctaAriaLabel}>
      {ctaLabel}
    </Button>
  </div>
</article>

<style>
  .plan-card {
    position: relative;
    scroll-snap-align: center;
    width: 70%;
    min-width: 190px;
    max-width: 300px;
    height: 250px;
    margin: var(--space-48) var(--space-4) 0;
    padding: 0 var(--space-16);
    background-color: var(--color-surface-card);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-on-light);
  }

  .plan-card__badge {
    position: absolute;
    top: calc(var(--space-16) * -1);
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
  }

  .plan-card__title {
    padding-top: var(--space-32);
    font-family: var(--text-body-sm-family);
    font-size: var(--text-body-sm-size);
    font-weight: var(--text-body-sm-weight);
    line-height: var(--text-body-sm-line);
    color: var(--color-text-strong);
  }

  .plan-card__price {
    padding: var(--space-4) 0;
    font-family: var(--text-price-family);
    font-size: var(--text-price-size);
    font-weight: var(--text-price-weight);
    line-height: var(--text-price-line);
    color: var(--color-text-strong);
  }

  .plan-card__price span {
    font-family: var(--text-note-family);
    font-size: var(--text-note-size);
    font-weight: var(--text-note-weight);
    vertical-align: text-top;
  }

  /* Reserva dos líneas para que los botones de las tarjetas queden alineados. */
  .plan-card__note {
    min-height: calc(var(--text-note-line) * 2);
    font-family: var(--text-note-family);
    font-size: var(--text-note-size);
    font-weight: var(--text-note-weight);
    line-height: var(--text-note-line);
    color: var(--color-text-muted);
  }

  .plan-card__action {
    display: flex;
    justify-content: center;
    margin-top: var(--space-20);
  }
</style>
