---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon/Icon.astro";
import Button from "../components/Button/Button.astro";
import Badge from "../components/Badge/Badge.astro";
---

<BaseLayout>
    <header>
      <img src="/assets/img/logo.svg" alt="" />
      <div class="header--title-container">
        <h1>La próxima revolución en el intercambio de criptomonedas.</h1>
        <p>
          Batabit te ayuda a navegar entre los diferentes precios y tendencias.
        </p>
        <div class="hero-cta">
          <Button variant="light" as="a" href="#plans" icon="arrow-down">Conoce Nuestros Planes</Button>
        </div>
      </div>
    </header>
    <main>
      <section class="main-exchange-container">
        <div class="backgroundImg"></div>
        <div class="main-exchange-container--title">
          <h2>Visibilizamos todas las tasas de cambio.</h2>
          <p>
            Traemos información en tiempo real de las casas de cambio y las
            monedas más importantes del mundo.
          </p>
        </div>
        <section class="main-tables-container">
          <div class="main-currency-table">
            <p class="currency-table--title __orange">Monedas</p>
            <div class="currency-table--container">
              <div class="currency-table--container--grid">
                <div class="grid__top-left">Bitcoin</div>
                <div class="grid__top-right">
                  $ 1.96 <span class="icon"><Icon name="trending-down" size="sm" label="A la baja" /></span>
                </div>

                <div>Ethereum</div>
                <div>$ 0.07<span class="icon"><Icon name="trending-up" size="sm" label="Al alza" /></span></div>

                <div>Ripple</div>
                <div>$ 2.15 <span class="icon"><Icon name="trending-down" size="sm" label="A la baja" /></span></div>

                <div class="grid__bottom-left">Stellar</div>
                <div class="grid__bottom-right">
                  $ 4.96 <span class="icon"><Icon name="trending-down" size="sm" label="A la baja" /></span>
                </div>
              </div>
            </div>
            <div class="currency-table--date">
              <Badge tone="primary-soft"><strong>Actualizado</strong>: 19 Julio 23:45</Badge>
            </div>
          </div>
          <div class="main-currency-table">
            <p class="currency-table--title __blue">Comisiones</p>
            <div class="currency-table--container">
              <div class="currency-table--container--grid">
                <div class="grid__top-left">Bitrade</div>
                <div class="grid__top-right">$ 12.96</div>

                <div>Bitpreco</div>
                <div>$ 13.07</div>

                <div class="grid__bottom-left">Novadax</div>
                <div class="grid__bottom-right">$ 13.15</div>

                <div>Coinext</div>
                <div>$ 14.96</div>
              </div>
            </div>
            <div class="currency-table--date">
              <Badge tone="secondary-soft"><strong>Actualizado</strong>: 19 Julio 23:45</Badge>
            </div>
          </div>
        </section>
      </section>
      <section class="main-product-detail">
        <span class="product-detail--batata-log"></span>
        <div class="product-detail--title">
          <h2>Creamos un producto sin comparación.</h2>
          <p>Confiable y diseñado para su uso diario.</p>
        </div>
        <section class="product-cards--container">
          <article class="product-detail--card">
            <span class="icon-card"><Icon name="clock" /></span>
            <p class="product--card-title">Tiempo real</p>
            <p class="product--card-body">
              Nuestro API toma información minuto a minuto sobre las tasas que
              más determinan el comportamiento.
            </p>
          </article>
          <article class="product-detail--card">
            <span class="icon-card"><Icon name="eye" /></span>
            <p class="product--card-title">No hay tasas escondidas</p>
            <p class="product--card-body">
              Ni en la compra o al momento de exit, Batabit siempre te muestra
              el costo real de lo que estás adquiriendo.
            </p>
          </article>
          <article class="product-detail--card">
            <span class="icon-card"><Icon name="dollar-sign" /></span>
            <p class="product--card-title">Compara monedas</p>
            <p class="product--card-body">
              No más rumores, con Babtabit sabrás el valor real de cada moneda
              en el mercado actual.
            </p>
          </article>
          <article class="product-detail--card">
            <span class="icon-card"><Icon name="check-circle" /></span>
            <p class="product--card-title">Información confiable</p>
            <p class="product--card-body">
              Nuestras fuentes están 100% verificadas y continuamos auditando su
              contenido mientras se actualizan.
            </p>
          </article>
        </section>
      </section>
      <section class="bitcoin-img-container">
        <h2>Conócelo hoy.</h2>
      </section>
      <section id="plans" class="main-plans-container">
        <div class="plans--title">
          <h2>Escoge el plan que mejor se ajuste a ti.</h2>
          <p>Cualquier plan te da acceso completo a nuestra plataforma.</p>
        </div>
        <section class="plans-container--slider">
          <article class="plans-container--card">
            <div class="plan-info-container">
              <div class="plans-container--badge"><Badge tone="secondary" size="sm">Más vendido</Badge></div>
              <h3 class="plan-card--title">Pago Mensual</h3>
              <p class="plan-card--price"><span>$</span> 19</p>
              <p class="plan-card--saving">*Acceso a servicios Pro</p>
              <div class="plan-card--action"><Button variant="outline" icon="arrow-right" ariaLabel="Escoger este plan: Pago Mensual">Escoger este</Button></div>
            </div>
          </article>
          <article class="plans-container--card">
            <div class="plans-container--badge"><Badge tone="primary" size="sm">Recomendado</Badge></div>
            <div class="plan-info-container">
              <h3 class="plan-card--title">Pago Anual</h3>
              <p class="plan-card--price"><span>$</span> 99</p>
              <p class="plan-card--saving">
                *Ahorras $129 comparado al plan mensual.
              </p>
              <div class="plan-card--action"><Button variant="outline" icon="arrow-right" ariaLabel="Escoger este plan: Pago Anual">Escoger este</Button></div>
            </div>
          </article>
          <article class="plans-container--card">
            <div class="plan-info-container">
              <h3 class="plan-card--title">Pago Diario</h3>
              <p class="plan-card--price"><span>$</span> 17</p>
              <p class="plan-card--saving">
                *Acceso a servicios Pro durante un dia
              </p>
              <div class="plan-card--action"><Button variant="outline" icon="arrow-right" ariaLabel="Escoger este plan: Pago Diario">Escoger este</Button></div>
            </div>
          </article>
        </section>
      </section>
    </main>
    <footer>
      <section class="left">
        <ul>
          <li><a href="#">Linkedin</a></li>
          <li><a href="#">Crunchbase</a></li>
          <li><a href="#">Hackernews</a></li>
        </ul>
      </section>
      <section class="right">
        <img src="/assets/img/logo-footer.svg" alt="Logo de Batatabit 2020" />
      </section>
    </footer>
</BaseLayout>
